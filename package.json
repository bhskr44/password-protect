{
  "name": "password-protect",
  "version": "1.2.2",
  "description": "Password-protect any file or folder with authenticated encryption.",
  "type": "module",
  "bin": {
    "protect": "bin/protect.js"
  },
  "scripts": {
    "test": "node --test test/",
    "test:app": "node --test e2e/",
    "start": "electron .",
    "build:cli": "sh scripts/build-cli.sh",
    "build:mac": "electron-builder --mac --publish never",
    "build:win": "electron-builder --win --publish never"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1"
  },
  "productName": "Password Protect",
  "author": "Bhaskar Ranjan Bora",
  "main": "desktop/main.js",
  "build": {
    "appId": "io.github.bhskr44.passwordprotect",
    "artifactName": "PasswordProtect-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "desktop/**",
      "lib/**",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "locked",
        "name": "Locked item",
        "role": "Editor"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "identity": "-",
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Locked item",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner",
            "CFBundleTypeExtensions": [
              "locked"
            ]
          },
          {
            "CFBundleTypeName": "Any file or folder",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.item",
              "public.folder"
            ]
          }
        ]
      },
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Password Protect"
    }
  },
  "overrides": {
    "undici-types": "8.12.3",
    "@electron/universal": {
      "minimatch": "11.0.4"
    },
    "app-builder-lib": {
      "minimatch": "11.0.4"
    }
  }
}
